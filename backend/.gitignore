# ==============================================================================
# .gitignore automatically generated for 'rag_based' project
# ==============================================================================

# ==============================================================================
# Environment & Secrets (NEVER COMMIT SENSITIVE DATA)
# ==============================================================================
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.template

# ==============================================================================
# Virtual Environments
# ==============================================================================
.venv/
venv/
ENV/
env/
.env/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/

# ==============================================================================
# Python Bytecode & Cache
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ==============================================================================
# Distribution & Packaging
# ==============================================================================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==============================================================================
# Testing, Coverage & Linters
# ==============================================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.pytype/
.ruff_cache/
.coverage
coverage.xml
nosetests.xml

# ==============================================================================
# Operating System Artifacts
# ==============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~

# ==============================================================================
# IDEs & Text Editors
# ==============================================================================
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# ==============================================================================
# Logs & Diagnostic Dumps
# ==============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================================================================
# AI / Machine Learning (Checkpoints, Weights & Large Datasets)
# ==============================================================================
# Model Weights & Checkpoints (store on HF Hub, S3, or GCS instead)
models/*.pt
models/*.pth
models/*.bin
models/*.onnx
models/*.safetensors
models/*.h5
*.pkl
checkpoints/
artifacts/

# Large Datasets
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Experiment Tracking
wandb/
mlruns/
lightning_logs/

# Notebook Checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# DVC (Data Version Control) Local Storage
.dvc/cache/
.dvc/tmp/

# ==============================================================================
# RAG & Vector Databases
# ==============================================================================
chroma_db/
faiss_index/
qdrant_storage/
lancedb/
.vector_cache/

# Document Ingestion Cache
data/documents/*
!data/documents/.gitkeep
cache/

# Local Vector & Metadata Stores
*.sqlite3
*.db


# testing 
test/*
test/
testing.py
testing.py
test/
